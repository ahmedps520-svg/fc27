{
  "name": "apexxi",
  "version": "1.0.0",
  "private": true,
  "description": "APEX XI \u2014 an original football card-collecting and club-management game, with online play.",
  "license": "MIT",
  "type": "commonjs",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "test": "npm run test:unit && npm run test:sweep && npm run test:smoke",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:sweep": "node tests/sweep-check.mjs",
    "test:smoke": "node tests/smoke/run.mjs",
    "build:watch": "node tools/build-watch.mjs",
    "release": "node tools/release.mjs",
    "test:qa": "node tests/qa/bot.mjs"
  },
  "engines": {
    "node": ">=18 <27"
  },
  "dependencies": {},
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.56.1"
  }
}
